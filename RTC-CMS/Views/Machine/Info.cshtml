@addTagHelper *,Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Http
@using RTC_CMS.Common
@using RTC_CMS.Models
@{
    var user = Context.Session.GetObject<Users>("User");
    ViewData["Title"] = "Machine info";
    ViewData["NavHeader"] = "<span class='link-underline-secondary'>Thiết bị<span> <i class='fa-solid fa-angle-right'></i> Thông tin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/css/machines/info.css" rel="stylesheet" />
<div class="px-1 px-md-2 py-3">
    <div class="container-fluid px-1 px-md-2">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modal_tabs">Show</button>
    </div>
</div>
<!-- Modal -->
<div class="modal fade" id="modal_tabs" data-bs-keyboard="true" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen">
        <div class="modal-content">
            @* <div class="modal-header">
            </div> *@
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-body">
                <form>
                    <ul class="nav nav-tabs" id="myTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#machine_info"
                                    type="button" role="tab" aria-controls="home" aria-selected="true">
                                Thông tin máy
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#machine_history"
                                    type="button" role="tab" aria-controls="profile" aria-selected="false">
                                Lịch sử hoạt động
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#error_history"
                                    type="button" role="tab" aria-controls="contact" aria-selected="false">
                                Lịch sử lỗi
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#machine_status"
                                    type="button" role="tab" aria-controls="contact" aria-selected="false">
                                Dữ liệu chạy máy
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#machine_files"
                                    type="button" role="tab" aria-controls="contact" aria-selected="false">
                                File đính kèm
                            </button>
                        </li>
                    </ul>

                    <!-- Tab panes -->
                    <div class="tab-content pt-3">
                        <div class="tab-pane fade show active" id="machine_info" role="tabpanel" aria-labelledby="home-tab">
                            <div class="container mt-4">
                                <div class="card shadow-lg rounded-4 p-4 mb-3">
                                    <h5 class="card-title mb-3">Thông tin thiết bị</h5>
                                    <ul class="list-unstyled row">
                                        <li class="col-md-6 mb-2"><strong>Tên máy:</strong> Băng tải cấp liệu B204</li>
                                        <li class="col-md-6 mb-2"><strong>Mã máy:</strong> B204</li>
                                        <li class="col-md-6 mb-2"><strong>Khu vực:</strong> A-1</li>
                                        <li class="col-md-6 mb-2"><strong>IP:</strong> 172.135.1.12</li>
                                        <li class="col-md-6 mb-2"><strong>PORT:</strong> 3306</li>
                                    </ul>
                                </div>
                            </div>

                        </div>
                        <div class="tab-pane fade" id="machine_history" role="tabpanel" aria-labelledby="profile-tab">
                            <div class="container-fluid">
                                <div class="row">
                                    <div class="col-6 d-flex flex-column justify-content-evenly" style="min-height: 500px;">
                                        <div id="machine_history_table" class="table-bordered border-primary"></div>
                                    </div>

                                    <div class="col-6 d-flex flex-column justify-content-evenly" style="min-height: 500px;">
                                        <div class="chart c-blue mb-1 mx-auto"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="error_history" role="tabpanel" aria-labelledby="contact-tab">
                            <div class="container-fluid">
                                <div class="row">
                                    <div class="col-6 d-flex flex-column justify-content-evenly" style="min-height: 500px;">
                                        <div id="error_history_table" class="table-bordered border-primary"></div>
                                    </div>

                                    <div class="col-6 d-flex flex-column justify-content-evenly" style="min-height: 500px;">
                                        <div class="card-body p-0">
                                            <div class="card-body row m-0 px-auto pt-5">
                                                <div class="col-12 d-flex justify-content-evenly m-1">
                                                    <button class="btn btn-sm btn-outline-success  fw-bold ">&Sigma; RUN: 18 (H)</button>
                                                    <button class="btn btn-sm btn-outline-warning  fw-bold ">&Sigma; STOP: 2 (H)</button>
                                                    <button class="btn btn-sm btn-outline-danger   fw-bold ">&Sigma; ERROR: 2 (H)</button>
                                                </div>

                                                <div id="time_line_chart_2" class="timeline-chart p-0 h-100 col-12">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="machine_status" role="tabpanel" aria-labelledby="contact-tab">
                            <div class="container-fluid">
                                <div class="row">
                                    <div class="col-6 d-flex flex-column justify-content-evenly" style="min-height: 500px;">
                                        <div id="machine_status_table" class="table-bordered border-primary"></div>
                                    </div>

                                    <div class="col-6 d-flex flex-column justify-content-evenly" style="min-height: 500px;">
                                        <div class="card-body p-0">
                                            <div class="card-body row m-0 px-auto pt-5">
                                                <div class="col-12 d-flex justify-content-evenly m-1">
                                                    <button class="btn btn-sm btn-outline-success  fw-bold ">&Sigma; RUN: 18 (H)</button>
                                                    <button class="btn btn-sm btn-outline-warning  fw-bold ">&Sigma; STOP: 2 (H)</button>
                                                    <button class="btn btn-sm btn-outline-danger   fw-bold ">&Sigma; ERROR: 2 (H)</button>
                                                </div>

                                                <div id="time_line_chart_3" class="timeline-chart p-0 h-100 col-12">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="machine_files" role="tabpanel" aria-labelledby="contact-tab">
                            <div class="mb-3">
                                <button class="btn btn-primary" id="task_add"
                                        data-bs-toggle="modal" data-bs-target="#modal_add_task">
                                    <i class="fa-solid fa-plus"></i> Thêm
                                </button>
                                <button class="btn btn-success" id="task_edit">
                                    <i class="fa-solid fa-pen-to-square"></i> Sửa
                                </button>
                                <button class="btn btn-secondary" id="task_copy">
                                    <i class="fa-solid fa-copy"></i> Copy
                                </button>
                                <button class="btn btn-danger" id="task_delete">
                                    <i class="fa-solid fa-trash"></i> Xóa
                                </button>
                            </div>
                            <div class="accordion" id="accordionExample">
                                <div class="accordion-item">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                            <img src="~/imgs/excel.png" class="accordion-btn-img" /><span class="mx-1">Thông tin thiết bị.xlsx</span>
                                        </button>
                                    </h2>
                                    <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#accordionExample">
                                        <div class="accordion-body">
                                            <div class="d-flex justify-content-center">
                                                @* <iframe style="width: 800px;height:250px" src="https://rtceduvnnh-my.sharepoint.com/personal/tech20_rtc_edu_vn/_layouts/15/Doc.aspx?sourcedoc={9b7183a5-3f59-4c72-ab85-e3e4a3e86f7c}&amp;action=embedview" frameborder="0">
                                                    This is an embedded <a target="_blank" href="https://office.com">Microsoft Office</a> document, powered by <a target="_blank" href="https://office.com/webapps">Office</a>.
                                                </iframe> *@
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="accordion-item">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                            <img src="~/imgs/word.png" class="accordion-btn-img" /><span class="mx-1">Kế hoạch bảo dưỡng.docx</span>
                                        </button>
                                    </h2>
                                    <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                                        <div class="accordion-body">
                                            <strong>This is the second item’s accordion body.</strong> It is hidden by default, until the collapse plugin adds the appropriate classes that we use to style each element. These classes control the overall appearance, as well as the showing and hiding via CSS transitions. You can modify any of this with custom CSS or overriding our default variables. It’s also worth noting that just about any HTML can go within the <code>.accordion-body</code>, though the transition does limit overflow.
                                        </div>
                                    </div>
                                </div>
                                <div class="accordion-item">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                            <img src="~/imgs/pdf.png" class="accordion-btn-img" /><span class="mx-1">Bản thiết kế.pdf</span>
                                        </button>
                                    </h2>
                                    <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                                        <div class="accordion-body">
                                            <strong>This is the third item’s accordion body.</strong> It is hidden by default, until the collapse plugin adds the appropriate classes that we use to style each element. These classes control the overall appearance, as well as the showing and hiding via CSS transitions. You can modify any of this with custom CSS or overriding our default variables. It’s also worth noting that just about any HTML can go within the <code>.accordion-body</code>, though the transition does limit overflow.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            @* <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark"></i> Đóng
                </button>
            </div> *@
        </div>
    </div>
</div>
<script src="~/js/machines/info.js"></script>